# ==============================================================================
# NEXUS_SYS TRANSMISSION PROTOCOL — SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: Store your real credentials in .env. Never commit .env to git.

PORT=5000

# Recipient for contact form submissions
CONTACT_DESTINATION_EMAIL=shivamsakre10@gmail.com

# ------------------------------------------------------------------------------
# GOOGLE GEMINI AI (For Portfolio Copilot)
# ------------------------------------------------------------------------------
# Step 1: Open https://aistudio.google.com/ and sign in with your Google account
# Step 2: Click "Get API key" and create a key
# Step 3: Paste your key below
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# OPTION 1: GMAIL SMTP (Recommended & Free)
# ------------------------------------------------------------------------------
# Step 1: Open https://myaccount.google.com/security and enable 2-Step Verification
# Step 2: Open https://myaccount.google.com/apppasswords
# Step 3: Generate an App Password named "Portfolio Contact"
# Step 4: Paste the 16-character password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shivamsakre10@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM="Shivam Sakre Transmission" <shivamsakre10@gmail.com>

# ------------------------------------------------------------------------------
# OPTION 2: RESEND API KEY (Instant Free API, No App Password needed)
# ------------------------------------------------------------------------------
# Step 1: Sign up free at https://resend.com
# Step 2: Get your API Key
# RESEND_API_KEY=re_123456789
# SMTP_FROM="onboarding@resend.dev"

